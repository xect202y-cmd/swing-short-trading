# ─────────────────────────────────────────────────────────────
# 스윙 트레이딩 환경변수 예시.  실제 파일은 .env (또는 C:\hermes\config\.env.swing)
# 절대 git 에 커밋하지 마라. 키는 코드/로그/마크다운에 출력 금지.
# ─────────────────────────────────────────────────────────────

# ── 안전장치 (가장 중요) ──
# 기본은 페이퍼(모의) 트레이딩. 실전 주문은 아래 둘 다 true + config의 confirm 플래그까지 켜야 가능.
PAPER_TRADING=true
LIVE_TRADING=false
# 실전 이중 확인 플래그(LIVE_TRADING=true 여도 이게 없으면 실주문 차단)
I_UNDERSTAND_LIVE_RISK=false

# ── 옵시디언 볼트 경로 (실제 경로로 맞출 것) ──
# 기본값은 config.yaml 에 있고, 여기서 덮어쓸 수 있다.
OBSIDIAN_VAULT_ROOT=C:\Users\xect2\ObsidianVault\이용수_Wiki

# ── 한국투자증권 KIS Developers (없으면 PaperBroker 로 동작) ──
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
# real | vps(모의투자 도메인)
KIS_ENV=vps

# ── 선택: Discord 알림 (없으면 콘솔/마크다운만) ──
# 스윙 전용 웹훅 권장(Hermes 채널과 분리). 없으면 DISCORD_WEBHOOK_URL 폴백.
SWING_DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ── 선택: AI 최종 판단 + LLM 리뷰 (키 없으면 룰 기반만 동작, 안전) ──
# 키를 넣으면: 상위 BUY 후보를 '네 매매기법(playbook)' 렌즈로 LLM이 검수(매수/관망/회피).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OpenAI 호환 엔드포인트(기본 OpenAI). 다른 게이트웨이 쓰면 변경.
# OPENAI_BASE_URL=https://api.openai.com/v1
